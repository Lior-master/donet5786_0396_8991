<Window x:Class="PL.Courier.CourierDeliveryHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Courier Delivery History"
        Height="620"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="6">
            <TextBlock VerticalAlignment="Center" Margin="6,0" Text="Filter by Order Type:"/>
            <ComboBox x:Name="cmbFilterOrderType" Width="180" Margin="6,0" SelectionChanged="cmbFilterOrderType_SelectionChanged"/>
            <Button Content="Refresh" Margin="6,0" Click="BtnRefresh_Click"/>
            <Button Content="Close" Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgHistory"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  Margin="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Delivery ID" Binding="{Binding DeliveryId}" Width="80"/>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Order Type" Binding="{Binding OrderType}" Width="110"/>
                <DataGridTextColumn Header="Customer Address" Binding="{Binding CustomerAdress}" Width="*"/>
                <DataGridTextColumn Header="Transport" Binding="{Binding DeliveryTransport}" Width="100"/>
                <DataGridTextColumn Header="Distance (km)" Binding="{Binding ActualDistance, StringFormat={}{0:F2}}" Width="110"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding DeliveryTotalTime}" Width="110"/>
                <DataGridTextColumn Header="End Type" Binding="{Binding DeliveredStatus}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtStatus" Grid.Row="2" Margin="6" Foreground="#666" Text="Ready"/>
    </Grid>
</Window>