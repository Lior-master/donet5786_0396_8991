<Window x:Class="PL.Courier.CourierOrderSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Order"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="6">
            <TextBlock VerticalAlignment="Center" Margin="6,0" Text="Filter by Order Type:"/>
            <ComboBox x:Name="cmbFilterOrderType" Width="180" Margin="6,0" SelectionChanged="cmbFilterOrderType_SelectionChanged"/>
            <Button Content="Refresh" Margin="6,0" Click="BtnRefresh_Click"/>
            <Button Content="Close" Margin="6,0" Click="BtnClose_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgOpenOrders"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  Margin="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Order Type" Binding="{Binding OrderType}" Width="110"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="140"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding CustomerPhone}" Width="110"/>
                <DataGridTextColumn Header="Address" Binding="{Binding CustomerAddress}" Width="*"/>
                <DataGridTextColumn Header="Distance (km)" Binding="{Binding Distance, StringFormat={}{0:F2}}" Width="110"/>
                <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Foreground="#666" Margin="6,0" Text="Ready"/>
            <Button Content="Assign Selected Order" Click="BtnAssign_Click" Margin="6,0"/>
        </StackPanel>
    </Grid>
</Window>