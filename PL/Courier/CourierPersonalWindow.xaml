<Window x:Class="PL.CourierPersonalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Courier Dashboard"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Default Button Style -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- Label Style -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- Value Style -->
        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <DockPanel Grid.Row="0" Margin="10,0,10,10" Background="White">
            <Border Padding="15" Background="Transparent">
                <DockPanel LastChildFill="True">
                    <TextBlock FontSize="28"
                               FontWeight="Bold"
                               Text="Courier Dashboard"
                               DockPanel.Dock="Left"
                               Foreground="#007BFF"/>
                    <TextBlock FontSize="14"
                               Foreground="#666"
                               Text="{Binding Courier.Id, StringFormat=Courier ID: {0}}"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ==================== CONTENT ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== COURIER DETAILS SECTION ========== -->
            <GroupBox Header="Courier Profile" Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Courier ID -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Courier ID:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Courier.Id}"
                                   Style="{StaticResource ValueStyle}"
                                   FontWeight="Bold"
                                   Foreground="#007BFF"/>

                        <!-- Name -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Courier.Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Phone -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Courier.Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Courier.Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Password -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding Courier.Password, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Max Distance -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Max Distance (km):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Text="{Binding Courier.MaxDistance, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Transport -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Delivery Type:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Row="6" Grid.Column="1"
                                  ItemsSource="{Binding Source={StaticResource TransportsCollectionKey}}"
                                  SelectedItem="{Binding Courier.Transport, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Active -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Active Status:" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding Courier.IsActive, Mode=OneWay}"
                                      IsEnabled="False"/>
                            <TextBlock Text="{Binding Courier.IsActive, StringFormat=Status: {0}}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#666"/>
                        </StackPanel>

                        <!-- Start Date -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Start Date:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="8" Grid.Column="1"
                                   Text="{Binding Courier.StartDate, StringFormat=dd/MM/yyyy}"
                                   Style="{StaticResource ValueStyle}"
                                   Foreground="#28A745"/>

                        <!-- Role -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Role:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="9" Grid.Column="1"
                                   Text="{Binding Courier.Administrator}"
                                   Style="{StaticResource ValueStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="#6F42C1"/>

                        <Separator Grid.Row="10" Grid.ColumnSpan="2" Margin="0,10,0,10"/>

                        <!-- On-Time -->
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="On-Time Deliveries:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="11" Grid.Column="1"
                                   Text="{Binding Courier.NumberOfOnTimeDeliveries, StringFormat={}{0} deliveries}"
                                   Style="{StaticResource ValueStyle}"
                                   Foreground="#28A745"/>

                        <!-- Late -->
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Late Deliveries:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="12" Grid.Column="1"
                                   Text="{Binding Courier.NumberOfLateDeliveries, StringFormat={}{0} deliveries}"
                                   Style="{StaticResource ValueStyle}"
                                   Foreground="#DC3545"/>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="13" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,15,0,0">
                            <Button Content="💾 Update Profile" Click="BtnUpdate_Click"/>
                            <Button Content="📋 View History" Click="BtnHistory_Click"/>
                            <Button Content="📦 Choose Order"
                                    Click="BtnChooseOrder_Click"
                                    IsEnabled="{Binding CanChooseOrder}"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </GroupBox>

            <!-- ========== RIGHT SIDE (CURRENT ORDER) ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Current Delivery -->
                <GroupBox Header="Current Delivery"
                          Foreground="#DC3545"
                          Visibility="{Binding IsAnOrderInProgress}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Extended rows to accommodate all OrderInProgress fields -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Delivery ID -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Delivery ID:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding OrderInProgress.DeliveryId}"
                                     IsReadOnly="True"/>

                            <!-- Order ID -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Order ID:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding OrderInProgress.OrderId}"
                                     IsReadOnly="True"/>

                            <!-- Order Type -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Order Type:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding OrderInProgress.OrderType}"
                                     IsReadOnly="True"/>

                            <!-- Distance -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Distance (km):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding OrderInProgress.Distance}"
                                     IsReadOnly="True"/>

                            <!-- Pickup Time -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Pickup Time:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding OrderInProgress.PickupTime, StringFormat=dd-MM-yyyy HH:mm:ss}"
                                     IsReadOnly="True"/>

                            <!-- Arrival Time -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Arrival Time:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding OrderInProgress.ArrivalTime, StringFormat=dd-MM-yyyy HH:mm:ss}"
                                     IsReadOnly="True"/>

                            <!-- Schedule Status -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Schedule Status:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="6" Grid.Column="1"
                                     Text="{Binding OrderInProgress.ScheduleStatus}"
                                     IsReadOnly="True"/>

                            <!-- Order Status -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Order Status:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="7" Grid.Column="1"
                                     Text="{Binding OrderInProgress.OrderStatus}"
                                     IsReadOnly="True"/>

                            <!-- Description -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Description:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="8" Grid.Column="1"
                                     Text="{Binding OrderInProgress.Description}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Height="60"/>

                            <!-- Customer Name -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Customer Name:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="9" Grid.Column="1"
                                     Text="{Binding OrderInProgress.CustomerName}"
                                     IsReadOnly="True"/>

                            <!-- Customer Phone -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Customer Phone:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="10" Grid.Column="1"
                                     Text="{Binding OrderInProgress.CustomerPhone}"
                                     IsReadOnly="True"/>

                            <!-- Customer Address -->
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Customer Address:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="11" Grid.Column="1"
                                     Text="{Binding OrderInProgress.CustomerAddress}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Height="50"/>

                            <!-- Order Date -->
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Order Date:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="12" Grid.Column="1"
                                     Text="{Binding OrderInProgress.OrderDate, StringFormat=dd-MM-yyyy HH:mm:ss}"
                                     IsReadOnly="True"/>

                            <!-- Estimated Arrival Time -->
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Est. Arrival:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="13" Grid.Column="1"
                                     Text="{Binding OrderInProgress.EstimatedArrivalTime, StringFormat=dd-MM-yyyy HH:mm:ss}"
                                     IsReadOnly="True"/>

                            <!-- Max Delivery Time -->
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Max Delivery Time:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="14" Grid.Column="1"
                                     Text="{Binding OrderInProgress.MaxDeliveryTime, StringFormat=dd-MM-yyyy HH:mm:ss}"
                                     IsReadOnly="True"/>

                            <!-- Remaning Time -->
                            <TextBlock Grid.Row="15" Grid.Column="0" Text="Remaning Time:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="15" Grid.Column="1"
                                     Text="{Binding OrderInProgress.RemaningTime, StringFormat=hh\\:mm\\:ss}"
                                     IsReadOnly="True"/>

                            <!-- Finish Type -->
                            <TextBlock Grid.Row="16" Grid.Column="0" Text="Finish Type:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Row="16" Grid.Column="1"
                                      ItemsSource="{Binding Source={StaticResource DeliveredStatusCollectionKey}}"
                                      SelectedItem="{Binding SelectedFinishType, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Finish Button -->
                            <StackPanel Grid.Row="17" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,15,0,0">
                                <Button Content="✅ Complete Delivery"
                                        Click="BtnFinish_Click"
                                        Background="#28A745"
                                        Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#28A745"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Margin" Value="6"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#218838"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </GroupBox>

                <!-- No order message -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="20"
                            Visibility="{Binding IsNoOrderInProgress}">
                    <TextBlock Text="No Active Delivery"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#999"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Click 'Choose Order' to select a delivery"
                               FontSize="12"
                               Foreground="#BBB"
                               TextAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDD"
                BorderThickness="0,1,0,0"
                Padding="10">
            <TextBlock Foreground="#666"
                       FontSize="12"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       MinHeight="25"/>
        </Border>

    </Grid>
</Window>
