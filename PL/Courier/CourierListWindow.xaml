<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="Courier Management" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Add Button Style -->
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
            <TextBlock Text="👥 Courier List" Style="{StaticResource SectionHeaderStyle}"/>
        </Border>

        <!-- Filter Section -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- First Row - Filter Type Selection -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Filter By:" 
                           Style="{StaticResource FieldLabelStyle}" 
                           Margin="0,0,15,0"/>

                <ComboBox Grid.Row="0" Grid.Column="1" 
                          Name="cmbFilterType"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Source={StaticResource FilterTypeCourierCollectionKey}}"
                          SelectedValue="{Binding FilterTypeCourier, Mode=TwoWay}"
                          SelectionChanged="FilterType_SelectionChanged"/>

                <!-- Second Row - Specific Filter Selection (conditionally visible) -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Name="lblSpecificFilter"
                           Text="Select:" 
                           Style="{StaticResource FieldLabelStyle}" 
                           Margin="0,15,15,0"
                           Visibility="Collapsed"/>

                <!-- Transport Type ComboBox -->
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          Name="cmbTransportFilter"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Source={StaticResource TransportsCollectionKey}}"
                          SelectedValue="{Binding CourierDelivery, Mode=TwoWay}"
                          SelectionChanged="TransportFilter_SelectionChanged"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>

                <!-- Administrator Type ComboBox -->
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          Name="cmbAdministratorFilter"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Source={StaticResource AdministratorTypeCollectionKey}}"
                          SelectedValue="{Binding AdministratorFilter, Mode=TwoWay}"
                          SelectionChanged="AdministratorFilter_SelectionChanged"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>

                <!-- Active Status Selection -->
                <StackPanel Grid.Row="1" Grid.Column="1" 
                           Name="pnlActiveFilter"
                           Orientation="Horizontal"
                           Margin="0,15,0,0"
                           Visibility="Collapsed">
                    <RadioButton Name="rbActiveOnly" 
                                Content="Active Only" 
                                GroupName="ActiveFilter"
                                Margin="0,0,15,0"
                                Checked="ActiveFilter_Changed"/>
                    <RadioButton Name="rbInactiveOnly" 
                                Content="Inactive Only" 
                                GroupName="ActiveFilter"
                                Margin="0,0,15,0"
                                Checked="ActiveFilter_Changed"/>
                    <RadioButton Name="rbAll" 
                                Content="All" 
                                GroupName="ActiveFilter"
                                IsChecked="True"
                                Checked="ActiveFilter_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <DataGrid Style="{StaticResource ModernDataGridStyle}"
          ItemsSource="{Binding CourierList}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          MouseDoubleClick="dgCourierList_MouseDoubleClick">

                <DataGrid.Columns>

                    <!-- Id -->
                    <DataGridTextColumn Header="Id"
                            Binding="{Binding Id}"
                            Width="Auto" />

                    <!-- Name -->
                    <DataGridTextColumn Header="Name"
                            Binding="{Binding Name}"
                            Width="150" />

                    <!-- IsActive -->
                    <DataGridTemplateColumn Header="Is Active"
                                Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsEnabled="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsActive}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Transport -->
                    <DataGridTextColumn Header="Transport"
                            Binding="{Binding Transport}"
                            Width="Auto" />

                    <!-- StartDate -->
                    <DataGridTextColumn Header="Start Date"
                            Binding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}"
                            Width="Auto" />

                    <!-- OnTimes/Lates -->
                    <DataGridTextColumn Header="On Time"
                            Binding="{Binding NumberOfOnTimeDeliveries}"
                            Width="Auto" />

                    <DataGridTextColumn Header="Late"
                            Binding="{Binding NumberOfLateDeliveries}"
                            Width="Auto" />

                    <!-- ActualOrder -->
                    <DataGridTextColumn Header="Actual Order"
                            Binding="{Binding ActualOrder}"
                            Width="Auto" />

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="➕ Add Courier" 
                        Style="{StaticResource AddButtonStyle}"
                        Click="btnAddCourier_Click"
                        Width="150" Height="45"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
    
