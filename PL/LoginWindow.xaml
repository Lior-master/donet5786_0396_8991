<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Delivery Management System"
        Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="White" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" 
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Margin="10">
        
        <Grid>
            <!-- Top Gradient Banner -->
            <Border Grid.ColumnSpan="1" 
                    Height="140" 
                    CornerRadius="12,12,0,0"
                    Background="#2196F3"
                    VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Center" 
                           HorizontalAlignment="Center">
                    <TextBlock Text="🚚" 
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Wolt 2.0" 
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <StackPanel Margin="35,160,35,35"
                       VerticalAlignment="Top">
                
                <!-- Subtitle -->
                <TextBlock Text="Welcome Back"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#37474F"
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="Enter your credentials to access the system"
                           FontSize="12"
                           Foreground="#90A4AE"
                           Margin="0,0,0,35"/>

                <!-- ID Input -->
                <TextBlock Text="📌 ID"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#546E7A"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="tbId" 
                         Height="42" 
                         Margin="0,0,0,5"
                         Style="{StaticResource ModernTextBoxStyle}"
                         KeyDown="TbId_KeyDown"
                         TextChanged="TbId_TextChanged"/>
                
                <!-- ID Error Message -->
                <TextBlock x:Name="tbIdError"
                           FontSize="11"
                           Foreground="#F44336"
                           Margin="0,0,0,15"
                           Visibility="Collapsed"/>

                <!-- Password Input -->
                <TextBlock Text="🔐 Password"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#546E7A"
                           Margin="0,0,0,8"/>
                <PasswordBox x:Name="pbPassword" 
                            Height="42" 
                            Margin="0,0,0,5"
                            Style="{StaticResource ModernPasswordBoxStyle}"
                            KeyDown="PbPassword_KeyDown"/>

                <!-- Password Error Message -->
                <TextBlock x:Name="tbPasswordError"
                           FontSize="11"
                           Foreground="#F44336"
                           Margin="0,0,0,15"
                           Visibility="Collapsed"/>

                <!-- General Error Message -->
                <TextBlock x:Name="tbGeneralError"
                           FontSize="11"
                           Foreground="#F44336"
                           Margin="0,0,0,15"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button Content="🔓 Login" 
                       Style="{StaticResource ModernButtonStyle}"
                       Height="50" 
                       Margin="0,0,0,12"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Click="BtnLogin_Click"/>

                <!-- Close Button -->
                <Button Content="Close" 
                       Style="{StaticResource ModernButtonStyle}"
                       Background="#90A4AE"
                       Height="42"
                       Click="BtnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#78909C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
