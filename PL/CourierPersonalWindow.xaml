<Window x:Class="PL.CourierPersonalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Courier Dashboard"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- TextBlock Label Style -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- TextBlock Value Style -->
        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <DockPanel Grid.Row="0" Margin="10,0,10,10" Background="White">
            <DockPanel.Resources>
                <!-- (keep any resources here if present) -->
            </DockPanel.Resources>
            <Border Padding="15" Background="Transparent">
                <DockPanel LastChildFill="True">
                    <TextBlock FontSize="28" 
                               FontWeight="Bold" 
                               Text="Courier Dashboard" 
                               DockPanel.Dock="Left"
                               Foreground="#007BFF"/>
                    <TextBlock FontSize="14" 
                               Foreground="#666"
                               Text="{Binding CourierId, StringFormat='Courier ID: {0}'}"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ==================== CONTENT ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== COURIER DETAILS SECTION ========== -->
            <GroupBox Header="Courier Profile" Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Courier ID (Read-Only) -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Courier ID:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding Courier.Id}"
                                   Style="{StaticResource ValueStyle}"
                                   FontWeight="Bold"
                                   Foreground="#007BFF"/>

                        <!-- Name Field -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding Courier.Name, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Your full name"/>

                        <!-- Phone Field -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding Courier.Phone, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Contact phone number"/>

                        <!-- Email Field -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                 Text="{Binding Courier.Email, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Contact email address"/>

                        <!-- Password Field -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Column="1" Grid.Row="4"
                                  Text="{Binding Courier.Password, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Your account password"/> 

                        <!-- Max Distance Field -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Max Distance (km):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" 
                                 Text="{Binding Courier.MaxDistance, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Maximum delivery distance"/>

                        <!-- Delivery Transport Type Field -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Delivery Type:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Row="6" Grid.Column="1"
                                  ItemsSource="{Binding DeliveryTypes}"
                                  SelectedItem="{Binding Courier.Transport, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Your primary transport method"/>

                        <!-- Active Status Field (Read-Only) -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Active Status:" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding Courier.IsActive, Mode=OneWay}"
                                      IsEnabled="False"
                                      ToolTip="Your active status (controlled by manager only)"/>
                            <TextBlock Text="{Binding Courier.IsActive, StringFormat='Status: {0}'}" 
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#666"/>
                        </StackPanel>

                        <!-- Start Date (Read-Only) -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Start Date:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" 
                                   Text="{Binding Courier.StartDate, StringFormat='dd/MM/yyyy'}"
                                   Style="{StaticResource ValueStyle}"
                                   Foreground="#28A745"/>

                        <!-- Administrator Role (Read-Only) -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Role:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" 
                                   Text="{Binding Courier.Administrator}"
                                   Style="{StaticResource ValueStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="#6F42C1"/>

                        <!-- Statistics Section -->
                        <Separator Grid.Row="10" Grid.ColumnSpan="2" Margin="0,10,0,10"/>

                        <!-- On-Time Deliveries -->
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="On-Time Deliveries:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" 
                                   Text="{Binding Courier.NumberOfOnTimeDeliveries, StringFormat={}{0} deliveries}"
                                   Style="{StaticResource ValueStyle}"
                                   Foreground="#28A745"/>

                        <!-- Late Deliveries -->
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Late Deliveries:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" 
                                   Text="{Binding Courier.NumberOfLateDeliveries, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0} deliveries}"
                                   Style="{StaticResource ValueStyle}"
                                   Foreground="#DC3545"/>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="13" Grid.ColumnSpan="2" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right"
                                    Margin="0,15,0,0">
                            <Button Content="💾 Update Profile" 
                                    Click="BtnUpdate_Click"
                                    ToolTip="Save changes to your profile"/>
                            <Button Content="📋 View History" 
                                    Click="BtnHistory_Click"
                                    ToolTip="View your delivery history"/>
                            <Button Content="📦 Choose Order" 
                                    Click="BtnChooseOrder_Click"
                                    IsEnabled="{Binding CanChooseOrder}"
                                    ToolTip="Select a new order to deliver"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </GroupBox>

            <!-- ========== ORDER IN PROGRESS SECTION ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- GroupBox with Order Details -->
                <GroupBox Header="Current Delivery" Foreground="#DC3545"
                          Visibility="{Binding IsAnOrderInProgress}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/> <!-- added to avoid overlap -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Order ID -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Order ID:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding OrderInProgress.OrderId}"
                                       Style="{StaticResource ValueStyle}"
                                       FontWeight="Bold"
                                       Foreground="#DC3545"/>

                            <!-- Customer Name -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding OrderInProgress.CustomerName}"
                                       Style="{StaticResource ValueStyle}"/>

                            <!-- Customer Phone -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding OrderInProgress.CustomerPhone}"
                                       Style="{StaticResource ValueStyle}"/>

                            <!-- Delivery Address -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Address:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding OrderInProgress.CustomerAddress}"
                                       Style="{StaticResource ValueStyle}"
                                       TextWrapping="Wrap"/>

                            <!-- Distance -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Distance:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" 
                                       Text="{Binding DisplayDistanceText}"
                                       Style="{StaticResource ValueStyle}"/>

                            <!-- Order Date/Time -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Order Date:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" 
                                       Text="{Binding OrderInProgress.OrderDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                       Style="{StaticResource ValueStyle}"/>

                            <!-- Delivery Schedule Status -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Schedule:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" 
                                       Text="{Binding OrderInProgress.ScheduleStatus}"
                                       Style="{StaticResource ValueStyle}"/>

                            <!-- Delivery Type (In Progress / Arrived) -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Delivery Type:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1"
                                       Text="{Binding DeliveryStatusText}"
                                       Style="{StaticResource ValueStyle}"/>

                            <!-- Finish Type Selection (only visible when arrival recorded) -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Finish Type:" Style="{StaticResource LabelStyle}"
                                       Visibility="{Binding IsDeliveryEndTypeVisible}"/>
                            <ComboBox Grid.Row="8" Grid.Column="1"
                                      ItemsSource="{Binding DeliveryFinishTypes}"
                                      SelectedItem="{Binding SelectedFinishType, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Select how this delivery ended"
                                      Visibility="{Binding IsDeliveryEndTypeVisible}"/>

                            <!-- Finish Button -->
                            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Right"
                                        Margin="0,15,0,0">
                                <Button Content="✅ Complete Delivery" 
                                        Click="BtnFinish_Click"
                                        Background="#28A745"
                                        ToolTip="Mark this delivery as complete">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#28A745"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#218838"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </GroupBox>

                <!-- Empty Message When No Order -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="20"
                            Visibility="{Binding IsNoOrderInProgress}">
                    <TextBlock Text="No Active Delivery" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#999"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Click 'Choose Order' to select a delivery" 
                               FontSize="12" 
                               Foreground="#BBB"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#DDD" 
                BorderThickness="0,1,0,0"
                Padding="10">
            <TextBlock Foreground="#666"
                       FontSize="12"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       MinHeight="25"/>
        </Border>
    </Grid>
</Window>
