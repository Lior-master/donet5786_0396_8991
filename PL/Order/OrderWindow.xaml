<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL"
        mc:Ignorable="d"
        Title="Order Details"
        Height="750" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save Button Style -->
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <!-- Enum sources for ComboBoxes -->
        <ObjectDataProvider x:Key="OrderTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:OrderType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="FragilityValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:FragilityLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="OrderStatusValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:OrderStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ScheduleStatusValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:ScheduleStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,20">
            <TextBlock Text="📦 Order Details" Style="{StaticResource SectionHeaderStyle}"/>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="30" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Order ID (init -> readonly) -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Order ID:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsReadOnly="True"
                             Text="{Binding OrderCurrent.Id}"
                             Margin="0,0,0,15"/>

                    <!-- Order Type (set -> editable) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Order Type:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{Binding Source={StaticResource OrderTypeValues}}"
                              SelectedItem="{Binding OrderCurrent.Type}"
                              Margin="0,0,0,15"/>

                    <!-- Customer Name (set -> editable) -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer Name:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding OrderCurrent.CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <!-- Customer Phone (set -> editable) -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Customer Phone:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding OrderCurrent.CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <!-- Customer Address (set -> editable) -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Delivery Address:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding OrderCurrent.CustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,15"/>

                    <!-- Weight (set -> editable, nullable) -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Weight (kg):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding OrderCurrent.Weight, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Margin="0,0,0,15"/>

                    <!-- Volume (set -> editable, nullable) -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Volume:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding OrderCurrent.Volume, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Margin="0,0,0,15"/>

                    <!-- Fragility Level (set -> editable, nullable enum) -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Fragility Level:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="7" Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{Binding Source={StaticResource FragilityValues}}"
                              SelectedItem="{Binding OrderCurrent.Fragility}"
                              Margin="0,0,0,15"/>

                    <!-- Order Description (set -> editable, nullable) -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Description:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="8" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding OrderCurrent.OrderDescription, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Margin="0,0,0,15"/>

                    <!-- Order Date (init -> readonly display) -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Order Date:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="9" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsReadOnly="True"
                             Text="{Binding OrderCurrent.OrderDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                             Margin="0,0,0,15"/>

                    <!-- Status (init -> readonly display) -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Status:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="10" Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              IsEnabled="False"
                              ItemsSource="{Binding Source={StaticResource OrderStatusValues}}"
                              SelectedItem="{Binding OrderCurrent.Status}"
                              Margin="0,0,0,15"/>

                    <!-- Distance (init -> readonly display) -->
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Distance (km):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="11" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsReadOnly="True"
                             Text="{Binding OrderCurrent.Distance, StringFormat={}{0:0.00}}"
                             Margin="0,0,0,15"/>

                    <!-- Estimated Arrival (init -> readonly display) -->
                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Estimated Arrival:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="12" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsReadOnly="True"
                             Text="{Binding OrderCurrent.ArrivalDateEstimeted, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='Not scheduled'}"
                             Margin="0,0,0,15"/>

                    <!-- Max Arrival Date (init -> readonly display) -->
                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Max Arrival Date:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="13" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsReadOnly="True"
                             Text="{Binding OrderCurrent.ArrivalDateMax, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='Not set'}"
                             Margin="0,0,0,15"/>

                    <!-- Schedule Status (init -> readonly display) -->
                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Schedule Status:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="14" Grid.Column="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              IsEnabled="False"
                              ItemsSource="{Binding Source={StaticResource ScheduleStatusCollectionKey}}"
                              SelectedItem="{Binding OrderCurrent.ScheduleStatus}"
                              Margin="0,0,0,15"/>

                    <!-- Arrival Estimate time -->
                    <TextBlock Grid.Row="15" Grid.Column="0" Text="Arrival Estimate Time:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="15" Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsReadOnly="True"
                             Text="{Binding OrderCurrent.ArrivalTimeEstimeted, StringFormat={}{0:hh\\:mm\\:ss}}"
                             Margin="0,0,0,15"/>

                    <!-- All Deliveries of this Order (if exist) -->
                    <TextBlock Grid.Row="16" Grid.Column="0" Text="Deliveries:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                    <ListBox Grid.Row="16" Grid.Column="1"
                             Height="120"
                             Background="White"
                             BorderBrush="#BDBDBD"
                             BorderThickness="1"
                             ItemsSource="{Binding OrderCurrent.DeliveriesPerOrder}"
                             Margin="0,0,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" 
                                        CornerRadius="4" Margin="2" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Delivery ID and Status -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Delivery ID:" FontWeight="Medium" FontSize="11" Foreground="#546E7A" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding DeliveryId}" FontWeight="Bold" FontSize="11" Foreground="#37474F"/>
                                            <TextBlock Text=" - Status: " FontSize="11" Foreground="#546E7A" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding DeliveredStatus, TargetNullValue='Pending'}" 
                                                       FontWeight="Medium" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF9800"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeliveredStatus}" Value="Delivered">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeliveredStatus}" Value="Failed">
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeliveredStatus}" Value="Rejected">
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeliveredStatus}" Value="Canceled">
                                                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeliveredStatus}" Value="Absent">
                                                                <Setter Property="Foreground" Value="#FF5722"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Courier and Transport -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Courier:" FontWeight="Medium" FontSize="11" Foreground="#546E7A" Margin="0,2,8,0"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding CourierName, TargetNullValue='Unassigned'}" FontSize="11" Foreground="#37474F"/>
                                            <TextBlock Text=" (ID: " FontSize="11" Foreground="#546E7A" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding CourierId, TargetNullValue='N/A'}" FontSize="11" Foreground="#37474F"/>
                                            <TextBlock Text=", " FontSize="11" Foreground="#546E7A"/>
                                            <TextBlock Text="{Binding transport}" FontSize="11" Foreground="#546E7A"/>
                                            <TextBlock Text=")" FontSize="11" Foreground="#546E7A"/>
                                        </StackPanel>

                                        <!-- Pickup Time -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pickup:" FontWeight="Medium" FontSize="11" Foreground="#546E7A" Margin="0,2,8,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                                   Text="{Binding PickupTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                                   FontSize="11" Foreground="#37474F" Margin="0,2,0,0"/>

                                        <!-- Arrival Time -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Arrival:" FontWeight="Medium" FontSize="11" Foreground="#546E7A" Margin="0,2,8,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" 
                                                   Text="{Binding ArrivalTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='Not arrived'}" 
                                                   FontSize="11" Foreground="#37474F" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Show message when no deliveries -->
                    <TextBox Grid.Row="16" Grid.Column="1"
                             Height="120"
                             IsReadOnly="True"
                             Text="No deliveries assigned yet"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Background="#F9F9F9"
                             Foreground="#666666"
                             FontStyle="Italic"
                             Margin="0,0,0,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OrderCurrent.DeliveriesPerOrder}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OrderCurrent.DeliveriesPerOrder.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="💾 Save"
                        Style="{StaticResource SaveButtonStyle}"
                        Width="120" Height="45"
                        Click="btnSave_Click"
                        Margin="0,0,15,0"/>

                <!-- Cancel Order button: visible only when OrderCurrent.Status == Pending -->
                <Button Content="❌ Cancel Order"
                        Width="140" Height="45"
                        Click="btnCancelOrder_Click"
                        Margin="0,0,15,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrderCurrent.Status}" Value="Pending">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OrderCurrent.Status}" Value="Processing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close button (always available) -->
                <Button Content="❌ Close"
                        Style="{StaticResource CancelButtonStyle}"
                        Width="120" Height="45"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
