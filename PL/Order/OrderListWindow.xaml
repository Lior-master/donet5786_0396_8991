<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="Order Management" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Add Button Style -->
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
            <TextBlock Text="📦 Order List" Style="{StaticResource SectionHeaderStyle}"/>
        </Border>

        <!-- Filter Section -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- First Row - Filter Type Selection -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Filter By:" 
                           Style="{StaticResource FieldLabelStyle}" 
                           Margin="0,0,15,0"/>

                <ComboBox Grid.Row="0" Grid.Column="1" 
                          Name="cmbFilterType"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Source={StaticResource FilterTypeOrderCollectionKey}}"
                          SelectedValue="{Binding FilterTypeOrder, Mode=TwoWay}"
                          SelectionChanged="FilterType_SelectionChanged"/>

                <!-- Second Row - Specific Filter Selection (conditionally visible) -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Name="lblSpecificFilter"
                           Text="Select:" 
                           Style="{StaticResource FieldLabelStyle}" 
                           Margin="0,15,15,0"
                           Visibility="Collapsed"/>

                <!-- Order Status ComboBox -->
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          Name="cmbOrderStatusFilter"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"
                          SelectedValue="{Binding OrderStatus, Mode=TwoWay}"
                          SelectionChanged="OrderStatusFilter_SelectionChanged"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>

                <!-- Order Type ComboBox -->
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          Name="cmbOrderTypeFilter"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Source={StaticResource OrderTypeCollectionKey}}"
                          SelectedValue="{Binding OrderType, Mode=TwoWay}"
                          SelectionChanged="OrderTypeFilter_SelectionChanged"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>

                <!-- Schedule Status ComboBox -->
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          Name="cmbScheduleStatusFilter"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Source={StaticResource ScheduleStatusCollectionKey}}"
                          SelectedValue="{Binding ScheduleStatus, Mode=TwoWay}"
                          SelectionChanged="ScheduleStatusFilter_SelectionChanged"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <DataGrid Style="{StaticResource ModernDataGridStyle}"
                      ItemsSource="{Binding OrderList}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="dgOrderList_MouseDoubleClick">

                <DataGrid.Columns>

                    <!-- Order Id -->
                    <DataGridTextColumn Header="Order Id"
                            Binding="{Binding OrderId}"
                            Width="80"/>

                    <!-- Delivery Id  -->
                    <DataGridTextColumn Header="Delivery Id"
                            Binding="{Binding DeliveryId}"
                            Width="90"/>

                    <!-- Type  -->
                    <DataGridTextColumn Header="Type"
                            Binding="{Binding Type}"
                            Width="100"/>

                    <!-- Distance (km, formatted) -->
                    <DataGridTextColumn Header="Distance (km)"
                            Binding="{Binding Distance, StringFormat={}{0:0.0}}"
                            Width="110"/>

                    <!-- Order Status -->
                    <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="110"/>

                    <!-- Schedule Status -->
                    <DataGridTextColumn Header="Schedule"
                            Binding="{Binding ScheduleStatus}"
                            Width="120"/>

                    <!-- Order End Time -->
                    <DataGridTextColumn Header="Order Time"
                            Binding="{Binding OrderEndTime}"
                            Width="120"/>

                    <!-- Treatment End Time -->
                    <DataGridTextColumn Header="Treatment Time"
                            Binding="{Binding TreatmentEndTime}"
                            Width="130"/>

                    <!-- Number of Couriers -->
                    <DataGridTextColumn Header="Couriers"
                            Binding="{Binding NumberOfCouriers}"
                            Width="90"/>

                    <!-- Cancel Button Column -->
                    <DataGridTemplateColumn Header="Action" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Name="btnCancelOrder"
                                        Content="❌ Cancel"
                                        Click="btnCancelOrder_Click"
                                        Tag="{Binding OrderId}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <!-- Show only for Pending orders -->
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="➕ Add Order" 
                        Style="{StaticResource AddButtonStyle}"
                        Click="btnNewOrder_Click"
                        Width="150" Height="45"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
