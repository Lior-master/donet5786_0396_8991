<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Delivery Management System" 
        Height="700" Width="1400"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- Background Image with White Overlay -->
    <Window.Background>
        <ImageBrush ImageSource="doodles-262500633.webp" 
                    Stretch="UniformToFill" 
                    Opacity="0.1"/>
    </Window.Background>

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Time Control Button Style -->
        <Style x:Key="TimeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#4A6572" />
            <Setter Property="Foreground" Value="White" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#344955"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#232F34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Initialize Style Button -->
        <Style x:Key="InitButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#F57C00" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E65100"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BF360C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Reset Style Button -->
        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#7F0000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ListButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#607D8B" />
            <Setter Property="Foreground" Value="White" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#455A64"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#37474F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Summary Cell Button Style -->
        <Style x:Key="SummaryCellStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Main Content with Semi-Transparent White Overlay -->
    <Grid>
        <!-- White Overlay for better readability -->
        <Grid.Background>
            <SolidColorBrush Color="White" Opacity="0.75"/>
        </Grid.Background>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================= -->
        <!--   LEFT PANEL — CONFIGURATION                           -->
        <!-- ======================================================= -->
        <Border Grid.Column="0" Background="White" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"
                Padding="20" Opacity="0.95">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="⚙️ Configuration" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Boss Credentials -->
                    <TextBlock Text="ADMINISTRATOR" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Boss ID" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.BossId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Boss Password" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.BossPassword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Speed Settings -->
                    <TextBlock Text="VEHICLE SPEEDS (km/h)" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Car Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.CarSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Motorcycle Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.MotorcycleSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Bike Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.BikeSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Walking Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.WalkingSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Delivery Settings -->
                    <TextBlock Text="DELIVERY PARAMETERS" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Max Delivery Time (minutes)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.MaxDeliveryTime, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Risk Range (minutes)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Inactivity Threshold (days)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.InactivityThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Max Distance (km)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.MaxDistance, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Location Settings -->
                    <TextBlock Text="COMPANY LOCATION" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.CompanyAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Latitude" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"
                                 Text="{Binding Configuration.CompanyLatitude, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Longitude" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"
                                 Text="{Binding Configuration.CompanyLongitude, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Button Content="↻ Reload Configuration"
                            Style="{StaticResource ModernButtonStyle}"
                            Height="40" Margin="0,5"
                            Click="LoadAllConfig_Click"/>

                    <Button Content="✓ Apply Changes"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#4CAF50"
                            Height="40" Margin="0,5"
                            Click="ApplyConfig_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================================================= -->
        <!--   CENTER PANEL — CLOCK AT TOP & TIME CONTROLS          -->
        <!-- ======================================================= -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            
            <!-- Clock Display at the top -->
            <Border Background="White" 
                    BorderBrush="#E0E0E0" BorderThickness="2"
                    CornerRadius="8"
                    Padding="25,15"
                    Margin="0,0,0,40" Opacity="0.95">
                <StackPanel>
                    <TextBlock Text="🕐 System Clock" 
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#546E7A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#37474F"
                               HorizontalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- Time Controls -->
            <TextBlock Text="Time Controls" 
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#546E7A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- 2 Rows x 3 Columns Grid for buttons -->
            <UniformGrid Columns="3" Rows="2" Width="600">
                <Button Content="+ 1 Second" Style="{StaticResource TimeButtonStyle}"
                        Height="50" Margin="8" Click="AddOneSecond_Click"/>
                <Button Content="+ 1 Minute" Style="{StaticResource TimeButtonStyle}"
                        Height="50" Margin="8" Click="AddOneMinute_Click"/>
                <Button Content="+ 1 Hour" Style="{StaticResource TimeButtonStyle}"
                        Height="50" Margin="8" Click="AddOneHour_Click"/>
                <Button Content="+ 1 Day" Style="{StaticResource TimeButtonStyle}"
                        Height="50" Margin="8" Click="AddOneDay_Click"/>
                <Button Content="+ 1 Month" Style="{StaticResource TimeButtonStyle}"
                        Height="50" Margin="8" Click="AddOneMonth_Click"/>
                <Button Content="+ 1 Year" Style="{StaticResource TimeButtonStyle}"
                        Height="50" Margin="8" Click="AddOneYear_Click"/>
            </UniformGrid>

            <!-- ======================================================= -->
            <!--   ORDER SUMMARY SECTION                                 -->
            <!-- ======================================================= -->
            <Border Background="White" 
                    BorderBrush="#E0E0E0" BorderThickness="2"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,30,0,0" Opacity="0.95"
                    MinWidth="650">
                <StackPanel>
                    <!-- Summary Title -->
                    <TextBlock Text="📊 Order Summary" 
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#546E7A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Summary Grid -->
                    <Grid Name="OrderSummaryGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Text="Schedule\Status" 
                                   FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="5" Padding="8,6"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="Pending" 
                                   FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="5" Padding="8,6"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" 
                                   Text="Processing" 
                                   FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="5" Padding="8,6"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="3" 
                                   Text="Delivered" 
                                   FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="5" Padding="8,6"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="4" 
                                   Text="Canceled" 
                                   FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="5" Padding="8,6"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="5" 
                                   Text="Returned" 
                                   FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="5" Padding="8,6"/>

                        <!-- OnTime Row -->
                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                   Text="OnTime" 
                                   FontWeight="Medium" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#4CAF50"
                                   Margin="5" Padding="8,6"/>
                        
                        <Button Grid.Row="1" Grid.Column="1" 
                                Content="{Binding OrderSummaryData[0]}"
                                Tag="OnTime,Pending"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="1" Grid.Column="2" 
                                Content="{Binding OrderSummaryData[1]}"
                                Tag="OnTime,Processing"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="1" Grid.Column="3" 
                                Content="{Binding OrderSummaryData[2]}"
                                Tag="OnTime,Delivered"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="1" Grid.Column="4" 
                                Content="{Binding OrderSummaryData[3]}"
                                Tag="OnTime,Canceled"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="1" Grid.Column="5" 
                                Content="{Binding OrderSummaryData[4]}"
                                Tag="OnTime,Returned"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>

                        <!-- Late Row -->
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                   Text="Late" 
                                   FontWeight="Medium" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#F44336"
                                   Margin="5" Padding="8,6"/>
                        
                        <Button Grid.Row="2" Grid.Column="1" 
                                Content="{Binding OrderSummaryData[5]}"
                                Tag="Late,Pending"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="2" Grid.Column="2" 
                                Content="{Binding OrderSummaryData[6]}"
                                Tag="Late,Processing"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="2" Grid.Column="3" 
                                Content="{Binding OrderSummaryData[7]}"
                                Tag="Late,Delivered"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="2" Grid.Column="4" 
                                Content="{Binding OrderSummaryData[8]}"
                                Tag="Late,Canceled"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="2" Grid.Column="5" 
                                Content="{Binding OrderSummaryData[9]}"
                                Tag="Late,Returned"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>

                        <!-- InRisk Row -->
                        <TextBlock Grid.Row="3" Grid.Column="0" 
                                   Text="InRisk" 
                                   FontWeight="Medium" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FF9800"
                                   Margin="5" Padding="8,6"/>
                        
                        <Button Grid.Row="3" Grid.Column="1" 
                                Content="{Binding OrderSummaryData[10]}"
                                Tag="InRisk,Pending"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="3" Grid.Column="2" 
                                Content="{Binding OrderSummaryData[11]}"
                                Tag="InRisk,Processing"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="3" Grid.Column="3" 
                                Content="{Binding OrderSummaryData[12]}"
                                Tag="InRisk,Delivered"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="3" Grid.Column="4" 
                                Content="{Binding OrderSummaryData[13]}"
                                Tag="InRisk,Canceled"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>
                        
                        <Button Grid.Row="3" Grid.Column="5" 
                                Content="{Binding OrderSummaryData[14]}"
                                Tag="InRisk,Returned"
                                Click="SummaryCell_Click"
                                Style="{StaticResource SummaryCellStyle}"
                                Margin="2" Height="35" FontSize="13"/>

                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ======================================================= -->
        <!--   RIGHT PANEL — NAVIGATION & ACTIONS                   -->
        <!-- ======================================================= -->
        <Border Grid.Column="2" Background="White" 
                BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                Padding="20" Opacity="0.95">
            <StackPanel VerticalAlignment="Center">
                
                <TextBlock Text="📊 Management" Style="{StaticResource SectionHeaderStyle}"/>

                <Button Content="👥 Couriers List"
                        Style="{StaticResource ListButtonStyle}"
                        Height="60" Margin="0,8"
                        Click="CouriersList_Click"/>

                <Button Content="📦 Orders List"
                        Style="{StaticResource ListButtonStyle}"
                        Height="60" Margin="0,8"
                        Click="OrdersList_Click"/>

                <Separator Margin="0,20" Background="#E0E0E0"/>

                <TextBlock Text="▶️ Simulator" Style="{StaticResource SectionHeaderStyle}"/>

                <StackPanel Name="SimulatorControlPanel">
                    <TextBlock Text="Clock Speed:" FontSize="12" Foreground="#546E7A" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox Name="SimulatorIntervalInput" 
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" Height="32"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0"/>
                        <TextBlock Text="min/sec" VerticalAlignment="Center" Foreground="#546E7A"/>
                    </StackPanel>

                    <Button Name="SimulatorToggleButton"
                            Content="▶ Start Simulator"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#00C853"
                            Height="50" Margin="0,8"
                            Click="SimulatorToggle_Click"/>
                </StackPanel>

                <Separator Margin="0,20" Background="#E0E0E0"/>

                <TextBlock Text="🗄️ Database" Style="{StaticResource SectionHeaderStyle}"/>

                <Button Content="🔄 Initialize DB"
                        Style="{StaticResource InitButtonStyle}"
                        Height="50" Margin="0,8"
                        Click="InitDB_Click"/>

                <Button Content="⚠️ Reset DB"
                        Style="{StaticResource ResetButtonStyle}"
                        Height="50" Margin="0,8"
                        Click="ResetDB_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
