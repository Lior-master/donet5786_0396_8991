<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Delivery Management System" 
        Height="700" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Time Control Button Style -->
        <Style x:Key="TimeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#607D8B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#546E7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================= -->
        <!--   LEFT PANEL — CONFIGURATION                           -->
        <!-- ======================================================= -->
        <Border Grid.Column="0" Background="White" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="⚙️ Configuration" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Boss Credentials -->
                    <TextBlock Text="ADMINISTRATOR" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Boss ID" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.BossId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Boss Password" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.BossPassword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Speed Settings -->
                    <TextBlock Text="VEHICLE SPEEDS (km/h)" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Car Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.CarSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Motorcycle Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.MotorcycleSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Bike Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.BikeSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Walking Speed" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.WalkingSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Delivery Settings -->
                    <TextBlock Text="DELIVERY PARAMETERS" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Max Delivery Time (minutes)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.MaxDeliveryTime, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Risk Range (minutes)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Inactivity Threshold (days)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.InactivityThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Max Distance (km)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.MaxDistance, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Location Settings -->
                    <TextBlock Text="COMPANY LOCATION" FontWeight="SemiBold" 
                               Foreground="#757575" FontSize="11" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.CompanyAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Latitude" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.CompanyLatitude, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Longitude" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding Configuration.CompanyLongitude, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Button Content="↻ Reload Configuration"
                            Style="{StaticResource ModernButtonStyle}"
                            Height="40" Margin="0,5"
                            Click="LoadAllConfig_Click"/>

                    <Button Content="✓ Apply Changes"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#4CAF50"
                            Height="40" Margin="0,5"
                            Click="ApplyConfig_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================================================= -->
        <!--   CENTER PANEL — CLOCK & TIME CONTROLS                 -->
        <!-- ======================================================= -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Clock Display -->
            <Border Background="White" 
                    BorderBrush="#E0E0E0" BorderThickness="2"
                    CornerRadius="8"
                    Padding="30,20"
                    Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="🕐 System Clock" 
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#546E7A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="#37474F"
                               HorizontalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- Time Controls -->
            <TextBlock Text="Time Controls" 
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#546E7A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <UniformGrid Columns="2" Rows="3" Width="450">
                <Button Content="+ 1 Second" Style="{StaticResource TimeButtonStyle}"
                        Height="45" Margin="5" Click="AddOneSecond_Click"/>
                <Button Content="+ 1 Minute" Style="{StaticResource TimeButtonStyle}"
                        Height="45" Margin="5" Click="AddOneMinute_Click"/>
                <Button Content="+ 1 Hour" Style="{StaticResource TimeButtonStyle}"
                        Height="45" Margin="5" Click="AddOneHour_Click"/>
                <Button Content="+ 1 Day" Style="{StaticResource TimeButtonStyle}"
                        Height="45" Margin="5" Click="AddOneDay_Click"/>
                <Button Content="+ 1 Month" Style="{StaticResource TimeButtonStyle}"
                        Height="45" Margin="5" Click="AddOneMonth_Click"/>
                <Button Content="+ 1 Year" Style="{StaticResource TimeButtonStyle}"
                        Height="45" Margin="5" Click="AddOneYear_Click"/>
            </UniformGrid>
        </StackPanel>

        <!-- ======================================================= -->
        <!--   RIGHT PANEL — NAVIGATION & ACTIONS                   -->
        <!-- ======================================================= -->
        <Border Grid.Column="2" Background="White" 
                BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                Padding="20">
            <StackPanel VerticalAlignment="Center">
                
                <TextBlock Text="📊 Management" Style="{StaticResource SectionHeaderStyle}"/>

                <Button Content="👥 Couriers List"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="70" Margin="0,10"
                        Click="CouriersList_Click"/>

                <Button Content="📦 Orders List"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="70" Margin="0,10"
                        Click="OrdersList_Click"/>

                <Separator Margin="0,30" Background="#E0E0E0"/>

                <TextBlock Text="🗄️ Database" Style="{StaticResource SectionHeaderStyle}"/>

                <Button Content="🔄 Initialize DB"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#FF9800"
                        Height="55" Margin="0,10"
                        Click="InitDB_Click"/>

                <Button Content="⚠️ Reset DB"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#F44336"
                        Height="55" Margin="0,10"
                        Click="ResetDB_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
