<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1200"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <!-- STRUCTURE PRINCIPALE (3 colonnes) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="28*"/>
            <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>


        <!-- ======================================================= -->
        <!--   COLONNE CENTRALE — HORLOGE + CONTROLES TEMPS         -->
        <!-- ======================================================= -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="325" Width="400">

            <!-- HORLOGE EN FORMAT FRANÇAIS -->
            <Label Content="{Binding CurrentTime, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"
                   HorizontalAlignment="Center"
                   FontSize="28" Height="50" Width="400"
                   HorizontalContentAlignment="Center"
                   Background="Cyan" Foreground="Blue" FontWeight="Bold"
                   BorderBrush="Black" BorderThickness="2" Margin="0,0,0,20"/>

            <!-- BOUTONS AVANCEMENT TEMPS -->
            <Button Content="Add One Second"
                    Height="35" Width="300" Margin="5"
                    FontSize="16" Background="GreenYellow"
                    Click="AddOneSecond_Click"/>

            <Button Content="Add One Minute"
                    Height="35" Width="300" Margin="5"
                    FontSize="16" Background="GreenYellow"
                    Click="AddOneMinute_Click"/>

            <Button Content="Add One Hour"
                    Height="35" Width="300" Margin="5"
                    FontSize="16" Background="GreenYellow"
                    Click="AddOneHour_Click"/>

            <Button Content="Add One Day"
                    Height="35" Width="300" Margin="5"
                    FontSize="16" Background="GreenYellow"
                    Click="AddOneDay_Click"/>

            <Button Content="Add One Month"
                    Height="35" Width="300" Margin="5"
                    FontSize="16" Background="GreenYellow"
                    Click="AddOneMonth_Click"/>

            <Button Content="Add One Year"
                    Height="35" Width="300" Margin="5"
                    FontSize="16" Background="GreenYellow"
                    Click="AddOneYear_Click"/>
        </StackPanel>


        <!-- ======================================================= -->
        <!--   COLONNE GAUCHE — CONFIGURATION COMPLETE              -->
        <!-- ======================================================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="10,10,2,10">
            <StackPanel>

                <TextBlock Text="Configuration Parameters"
                           FontSize="16" FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <!-- Chaque TextBox lié à Configuration -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Boss ID:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding Configuration.BossId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Boss Password:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="120" Text="{Binding Configuration.BossPassword, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Car Speed:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding Configuration.CarSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Motorcycle Speed:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding Configuration.MotorcycleSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Bike Speed:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding Configuration.BikeSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Walking Speed:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding Configuration.WalkingSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Max Delivery Time:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="50" Text="{Binding Configuration.MaxDeliveryTime, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="min" Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Risk Range:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="50" Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="min" Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Inactivity:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="50" Text="{Binding Configuration.InactivityThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="days" Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Company Address:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="150" Text="{Binding Configuration.CompanyAddress, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Latitude:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="90" Text="{Binding Configuration.CompanyLatitude, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Longitude:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="90" Text="{Binding Configuration.CompanyLongitude, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Max Distance:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="50" Text="{Binding Configuration.MaxDistance, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="km" Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>


                <StackPanel Margin="0,30">
                    <Button Content="Load All Config"
                            Height="35" Margin="0,5"
                            Background="LightBlue" FontSize="14"
                            Click="LoadAllConfig_Click"/>

                    <Button Content="Apply Configuration"
                            Height="35" Margin="0,5"
                            Background="LightGreen" FontSize="14"
                            Click="ApplyConfig_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>



        <!-- ======================================================= -->
        <!--   COLONNE DROITE — ACTIONS GENERALES                    -->
        <!-- ======================================================= -->
        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Height="320" Width="170">

            <Button Content="Reset DB"
                    Height="60" Width="150" Margin="10"
                    FontSize="16" Background="LightGray"
                    Click="ResetDB_Click"/>

            <Button Content="Init DB"
                    Height="60" Width="150" Margin="10"
                    FontSize="16" Background="LightGray"
                    Click="InitDB_Click"/>

            <Button Content="Couriers List"
                    Height="60" Width="150" Margin="10"
                    FontSize="16" Background="LightGray"
                    Click="CouriersList_Click"/>

            <Button Content="Orders List"
                    Height="60" Width="150" Margin="10"
                    FontSize="16" Background="LightGray"
                    Click="OrdersList_Click"/>

        </StackPanel>

    </Grid>
</Window>
